{
  "expo": {
    "name": "NovaID Business",
    "slug": "novaid-business",
    "version": "2026.1.0",
    "orientation": "portrait",
    "splash": {
      "backgroundColor": "#FFFFFF"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "extra": {
      "test_mode": true,
      "api_url": "https://your-backend-url",
      "eas": {
        "projectId": "d75288c7-a122-43ca-8c25-2a7443e6f499"
      }
    },
    "android": {
      "package": "com.novatech.novaid.business",
      "permissions": ["CAMERA", "USE_BIOMETRIC", "POST_NOTIFICATIONS"]
    },
    "ios": {
      "bundleIdentifier": "com.novatech.novaid.business",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "NovaID Business uses Face ID to verify directors and operators.",
        "NSCameraUsageDescription": "NovaID Business uses the camera to scan business credentials and seals."
      }
    },
    "owner": "ostrinov23",
    "plugins": [
      "expo-secure-store"
    ]
  }
}
