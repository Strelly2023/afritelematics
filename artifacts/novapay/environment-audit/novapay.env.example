# ============================================================
# NovaPay environment configuration
# Do not commit real secrets.
# ============================================================

# Runtime
AFRITECH_ENV=development
AFRITECH_MODE=local
NOVATECH_ENVIRONMENT=development
NOVATECH_RELEASE_ID=local-development

# Shared persistence
AFRITECH_DATABASE_URL=postgresql://novapay:CHANGE_ME@localhost:5432/novapay

# Authentication
# Generate a strong random value before non-local deployment.
AFRITECH_JWT_SECRET=CHANGE_ME

# NovaPay provider mode
# Expected values should be confirmed from source validation.
AFRIPAY_PROVIDER_MODE=mock

# Zero-knowledge proof tooling
AFRIPAY_SNARKJS_PATH=
AFRIPAY_GROTH16_WASM_PATH=
AFRIPAY_GROTH16_ZKEY_PATH=
AFRIPAY_GROTH16_VERIFICATION_KEY_PATH=

# Build and release provenance
BUILD_ACTOR=local
BUILD_ID=local
CI_PIPELINE_ID=
GIT_BRANCH=
GIT_COMMIT_SHA=
REPOSITORY_URL=
