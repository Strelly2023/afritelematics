+def test_serialization_replay_and_immutable_interactions_are_certified() -> None:
+    canonical_types = (
+        customer.Customer,
+        financial_account.FinancialAccount,
+        wallet.Wallet,
+        ledger_account.LedgerAccount,
+        balance_snapshot.BalanceSnapshot,
+    )
+
+    serialized_types = 0
+
+    for value in canonical_types:
+        assert is_dataclass(value)
+        assert value.__dataclass_params__.frozen is True
+
+        if SERIALIZATION_METHODS.intersection(
+            _public_methods(value)
+        ):
+            serialized_types += 1
+
+    assert serialized_types >= 4
+
+    tests = _focused_test_source().lower()
+
+    assert any(
+        token in tests
+        for token in (
+            "canonical_dict",
+            "round_trip",
+            "serialize",
+            "replay",
+            "immutable",
+            "mutation",
+        )
+    )
+
