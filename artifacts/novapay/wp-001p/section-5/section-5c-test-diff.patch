+def test_runtime_and_authority_boundaries_are_certified() -> None:
+    canonical_types = (
+        customer.Customer,
+        financial_account.FinancialAccount,
+        wallet.Wallet,
+        ledger_account.LedgerAccount,
+        balance_snapshot.BalanceSnapshot,
+    )
+
+    forbidden = {
+        "execute_payment",
+        "authorize_payment",
+        "capture_payment",
+        "debit_wallet",
+        "credit_wallet",
+        "post_ledger",
+        "settle_external",
+        "persist",
+        "save",
+        "repository",
+        "database",
+        "provider_client",
+        "network_client",
+        "http_client",
+        "publish",
+        "send",
+        "deliver",
+    }
+
+    for value in canonical_types:
+        names = {
+            name
+            for name in dir(value)
+            if not name.startswith("__")
+        }
+
+        assert forbidden.isdisjoint(names), (
+            value.__name__,
+            sorted(forbidden.intersection(names)),
+        )
+
+        assert forbidden.isdisjoint(
+            _field_names(value)
+        )
+
