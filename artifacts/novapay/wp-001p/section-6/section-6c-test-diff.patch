+FORBIDDEN_RUNTIME_IMPORT_ROOTS = {
+    "django",
+    "flask",
+    "fastapi",
+    "starlette",
+    "requests",
+    "httpx",
+    "aiohttp",
+    "sqlalchemy",
+    "psycopg",
+    "psycopg2",
+    "sqlite3",
+    "redis",
+    "celery",
+    "boto3",
+    "kafka",
+    "pika",
+}
+
+FORBIDDEN_RUNTIME_FIELDS = (
+    FORBIDDEN_PAYMENT_AUTHORITY
+    | FORBIDDEN_WALLET_AUTHORITY
+    | FORBIDDEN_LEDGER_AUTHORITY
+    | FORBIDDEN_TRANSFER_REMITTANCE_AUTHORITY
+    | FORBIDDEN_SETTLEMENT_RECONCILIATION_AUTHORITY
+    | FORBIDDEN_PERSISTENCE_AUTHORITY
+    | FORBIDDEN_PROVIDER_NETWORK_AUTHORITY
+    | FORBIDDEN_DELIVERY_AUTHORITY
+    | FORBIDDEN_EXTERNAL_CRYPTO_AUTHORITY
+)
+
+
+def _receipt_classes() -> tuple[type[object], ...]:
+    values: list[type[object]] = []
+
+    for symbol in receipt.__all__:
+        value = getattr(receipt, symbol)
+
+        if not inspect.isclass(value):
+            continue
+
+        if value.__module__ != receipt.__name__:
+            continue
+
+        values.append(value)
+
+    return tuple(values)
+
+
+def _member_names(value: type[object]) -> set[str]:
+    return {
+        name
+        for name in dir(value)
+        if not name.startswith("__")
+    }
+
+
+def _dataclass_field_names(value: type[object]) -> set[str]:
+    if not is_dataclass(value):
+        return set()
+
+    return {
+        item.name
+        for item in fields(value)
+    }
+
+
+def _assert_no_authority(
+    forbidden: set[str],
+) -> None:
+    violations: list[
+        tuple[str, str, list[str]]
+    ] = []
+
+    for value in _receipt_classes():
+        member_overlap = sorted(
+            forbidden.intersection(
+                _member_names(value)
+            )
+        )
+
+        if member_overlap:
+            violations.append(
+                (
+                    value.__name__,
+                    "member",
+                    member_overlap,
+                )
+            )
+
+        field_overlap = sorted(
+            forbidden.intersection(
+                _dataclass_field_names(value)
+            )
+        )
+
+        if field_overlap:
+            violations.append(
+                (
+                    value.__name__,
+                    "field",
+                    field_overlap,
+                )
+            )
+
+    assert violations == []
+
+
+def test_receipt_public_boundary_remains_canonical() -> None:
+    assert hasattr(receipt, "Receipt")
+    assert "Receipt" in receipt.__all__
+
+    assert not hasattr(domain, "Receipt")
+    assert "Receipt" not in domain.__all__
+
+    assert not hasattr(novapay, "Receipt")
+    assert "Receipt" not in novapay.__all__
+
+    for symbol in (
+        "ReceiptIntegrityEvidence",
+        "ReceiptVerificationResult",
+    ):
+        assert getattr(domain, symbol) is getattr(
+            receipt,
+            symbol,
+        )
+
+        assert getattr(novapay, symbol) is getattr(
+            receipt,
+            symbol,
+        )
+
+        assert symbol in receipt.__all__
+        assert symbol in domain.__all__
+        assert symbol in novapay.__all__
+
+    assert not hasattr(
+        receipt,
+        "ReceiptPresentationSummary",
+    )
+
+    assert not hasattr(
+        domain,
+        "ReceiptPresentationSummary",
+    )
+
+    assert not hasattr(
+        novapay,
+        "ReceiptPresentationSummary",
+    )
+
+
+def test_receipt_types_have_no_payment_execution_authority() -> None:
+    _assert_no_authority(
