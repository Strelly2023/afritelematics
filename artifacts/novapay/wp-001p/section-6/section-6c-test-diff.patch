+def test_receipt_dataclasses_hide_no_runtime_authority_fields() -> None:
+    violations: list[
+        tuple[str, list[str]]
+    ] = []
+
+    for value in _receipt_classes():
+        if not is_dataclass(value):
+            continue
+
+        assert value.__dataclass_params__.frozen is True
+
+        overlap = sorted(
+            FORBIDDEN_RUNTIME_FIELDS.intersection(
+                _dataclass_field_names(value)
+            )
+        )
+
+        if overlap:
+            violations.append(
+                (
+                    value.__name__,
+                    overlap,
+                )
+            )
+
+    assert violations == []
+
+
+def test_receipt_classes_hide_no_runtime_authority_callables() -> None:
+    violations: list[
+        tuple[str, list[str]]
+    ] = []
+
+    for value in _receipt_classes():
+        overlap = sorted(
+            FORBIDDEN_RUNTIME_FIELDS.intersection(
+                _member_names(value)
+            )
+        )
