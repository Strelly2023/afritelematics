+def test_receipt_module_has_no_runtime_framework_imports() -> None:
+    source = RECEIPT_MODULE_PATH.read_text(
+        encoding="utf-8"
+    )
+
+    tree = ast.parse(
+        source,
+        filename=str(RECEIPT_MODULE_PATH),
+    )
+
+    violations: list[
+        tuple[str, int]
+    ] = []
+
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Import):
+            for alias in node.names:
+                root = alias.name.split(".")[0]
+
+                if root in FORBIDDEN_RUNTIME_IMPORT_ROOTS:
+                    violations.append(
+                        (
+                            alias.name,
+                            node.lineno,
+                        )
+                    )
+
+        if isinstance(node, ast.ImportFrom):
+            if not node.module:
+                continue
+
+            root = node.module.split(".")[0]
+
+            if root in FORBIDDEN_RUNTIME_IMPORT_ROOTS:
+                violations.append(
+                    (
+                        node.module,
+                        node.lineno,
+                    )
+                )
+
+    assert violations == []
+
+
+def test_receipt_module_remains_replay_safe_and_side_effect_free() -> None:
+    source = RECEIPT_MODULE_PATH.read_text(
+        encoding="utf-8"
+    )
+
+    tree = ast.parse(
+        source,
+        filename=str(RECEIPT_MODULE_PATH),
+    )
+
+    forbidden_top_level_calls: list[
+        tuple[str, int]
+    ] = []
+
+    allowed_top_level_call_names = {
+        "TypeVar",
+        "compile",
+    }
+
+    for node in tree.body:
+        candidate: ast.AST | None = None
+
+        if isinstance(node, ast.Expr):
+            candidate = node.value
+
+        elif isinstance(node, ast.Assign):
+            candidate = node.value
+
+        elif isinstance(node, ast.AnnAssign):
+            candidate = node.value
+
+        if not isinstance(candidate, ast.Call):
+            continue
+
+        call_name = ""
+
+        if isinstance(candidate.func, ast.Name):
+            call_name = candidate.func.id
+
+        elif isinstance(candidate.func, ast.Attribute):
+            call_name = candidate.func.attr
+
+        if call_name in allowed_top_level_call_names:
+            continue
+
+        forbidden_top_level_calls.append(
+            (
+                call_name or "<dynamic>",
+                node.lineno,
+            )
+        )
+
+    assert forbidden_top_level_calls == []
