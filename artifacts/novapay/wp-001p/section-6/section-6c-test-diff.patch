+    "payment_provider",
+    "network_client",
+    "http_client",
+    "api_client",
+    "gateway_client",
+    "send_request",
+    "request_external",
+}
+
+FORBIDDEN_DELIVERY_AUTHORITY = {
+    "deliver",
+    "deliver_external",
+    "send_email",
+    "send_sms",
+    "publish",
+    "dispatch",
+    "notification_client",
+    "delivery_client",
+}
+
+FORBIDDEN_EXTERNAL_CRYPTO_AUTHORITY = {
+    "sign_external",
+    "verify_external",
+    "signing_service",
+    "verification_client",
+    "kms_client",
+    "hsm_client",
+    "private_key",
