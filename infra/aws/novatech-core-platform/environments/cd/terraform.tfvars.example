aws_region = "af-south-1"
name = "novatech-core-cd"
container_image = "123456789012.dkr.ecr.af-south-1.amazonaws.com/novatech-core:latest"
vpc_id = "vpc-0123456789abcdef3"
public_subnet_ids = ["subnet-dddddddd", "subnet-eeeeeeee"]
private_subnet_ids = ["subnet-ffffffff", "subnet-11112222"]
database_password = "change-me"
stripe_api_key_secret_arn = "arn:aws:secretsmanager:af-south-1:123456789012:secret:stripe-api-key"
event_bus_backend = "kafka"
event_bus_kafka_brokers = "b-1.cd.novapay.kafka:9092,b-2.cd.novapay.kafka:9092"
novapay_region = "CD"
novatrust_signing_provider = "aws_kms"
novatrust_kms_signing_enabled = true
novatrust_kms_signing_algorithm = "ECDSA_SHA_256"
novapay_cbdc_live_enabled = false
novapay_cbdc_network = "pilot-ledger"
novapay_rollout_mode = "pilot"
novapay_primary_corridor = "AU->CD"
novapay_corridors = ["AU->CD", "CD->AU"]
novapay_settlement_mode = "pre_funded"
novapay_mobile_money_live_enabled = true
novapay_compliance_provider = "sumsub"
novapay_compliance_live_enabled = true
novapay_env_vars = {
  NOVAPAY_ORANGE_CD_COLLECTION_URL = "https://cd.example.com/mobile-money/orange"
  NOVAPAY_ORANGE_CD_CALLBACK_URL   = "https://api.example.com/webhooks/payments"
  NOVAPAY_AIRTEL_CD_COLLECTION_URL  = "https://cd.example.com/mobile-money/airtel"
  NOVAPAY_AIRTEL_CD_CALLBACK_URL    = "https://api.example.com/webhooks/payments"
  NOVAPAY_MPESA_CD_COLLECTION_URL   = "https://cd.example.com/mobile-money/mpesa"
  NOVAPAY_MPESA_CD_CALLBACK_URL     = "https://api.example.com/webhooks/payments"
}
novapay_secret_arns = {
  NOVAPAY_WEBHOOK_SECRET            = "arn:aws:secretsmanager:af-south-1:123456789012:secret:novapay-webhook-secret"
  NOVAPAY_ORANGE_CD_API_TOKEN       = "arn:aws:secretsmanager:af-south-1:123456789012:secret:orange-cd-api-token"
  NOVAPAY_AIRTEL_CD_API_TOKEN       = "arn:aws:secretsmanager:af-south-1:123456789012:secret:airtel-cd-api-token"
  NOVAPAY_MPESA_CD_API_TOKEN        = "arn:aws:secretsmanager:af-south-1:123456789012:secret:mpesa-cd-api-token"
}
