{
  "aws_region": "af-south-1",
  "name": "novatech-core-bi",
  "container_image": "123456789012.dkr.ecr.af-south-1.amazonaws.com/novatech-core:latest",
  "vpc_id": "vpc-0123456789abcdef2",
  "public_subnet_ids": ["subnet-99999999", "subnet-aaaaaaaa"],
  "private_subnet_ids": ["subnet-bbbbbbbb", "subnet-cccccccc"],
  "database_password": "change-me",
  "stripe_api_key_secret_arn": "arn:aws:secretsmanager:af-south-1:123456789012:secret:stripe-api-key",
  "event_bus_backend": "kafka",
  "event_bus_kafka_brokers": "b-1.bi.novapay.kafka:9092,b-2.bi.novapay.kafka:9092",
  "novapay_region": "BI",
  "novatrust_signing_provider": "aws_kms",
  "novatrust_kms_signing_enabled": true,
  "novatrust_kms_signing_algorithm": "ECDSA_SHA_256",
  "novapay_cbdc_live_enabled": false,
  "novapay_cbdc_network": "pilot-ledger",
  "novapay_rollout_mode": "pilot",
  "novapay_primary_corridor": "AU->BI",
  "novapay_corridors": ["AU->BI", "BI->AU"],
  "novapay_settlement_mode": "pre_funded",
  "novapay_mobile_money_live_enabled": true,
  "novapay_compliance_provider": "sumsub",
  "novapay_compliance_live_enabled": true,
  "novapay_env_vars": {
    "NOVAPAY_LUMICASH_BI_COLLECTION_URL": "https://bi.example.com/mobile-money/lumicash",
    "NOVAPAY_LUMICASH_BI_CALLBACK_URL": "https://api.example.com/webhooks/payments",
    "NOVAPAY_ECOCASH_BI_COLLECTION_URL": "https://bi.example.com/mobile-money/ecocash",
    "NOVAPAY_ECOCASH_BI_CALLBACK_URL": "https://api.example.com/webhooks/payments"
  },
  "novapay_secret_arns": {
    "NOVAPAY_WEBHOOK_SECRET": "arn:aws:secretsmanager:af-south-1:123456789012:secret:novapay-webhook-secret",
    "NOVAPAY_LUMICASH_BI_API_TOKEN": "arn:aws:secretsmanager:af-south-1:123456789012:secret:lumicash-bi-api-token",
    "NOVAPAY_ECOCASH_BI_API_TOKEN": "arn:aws:secretsmanager:af-south-1:123456789012:secret:ecocash-bi-api-token"
  }
}
