{
  "environment": "PUBLIC_PILOT",
  "ga_enabled": false,
  "pilot_geography_restricted": true,
  "support_required": true,
  "rollback_required": true,
  "apps": {
    "novaride_rider": {
      "tabs": [
        "Home",
        "Book Ride",
        "Trips",
        "Wallet",
        "Safety",
        "Profile"
      ],
      "buttons": [
        {
          "label": "Set pickup location",
          "handler": "ride:set_pickup"
        },
        {
          "label": "Set destination",
          "handler": "ride:set_destination"
        },
        {
          "label": "Choose ride type",
          "handler": "ride:choose_type"
        },
        {
          "label": "Schedule ride",
          "handler": "ride:schedule"
        },
        {
          "label": "Confirm pickup",
          "handler": "ride:confirm_pickup",
          "confirmation_required": true
        },
        {
          "label": "View nearby drivers",
          "handler": "ride:view_drivers"
        },
        {
          "label": "Open safety center",
          "handler": "safe:open_center"
        },
        {
          "label": "Open wallet",
          "handler": "wallet:open"
