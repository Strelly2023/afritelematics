{
  "cli": {
    "appVersionSource": "remote",
    "version": ">= 10.0.0"
  },
  "build": {
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "ios": { "simulator": false },
      "env": {
        "EXPO_PUBLIC_NOVAID_TEST_MODE": "false",
        "EXPO_PUBLIC_NOVAID_USE_MOCKS": "false"
      }
    },
    "pilot-apk": {
      "developmentClient": false,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_NOVAID_TEST_MODE": "true",
        "EXPO_PUBLIC_NOVAID_APP_VERSION": "2026.1.0",
        "EXPO_PUBLIC_NOVAID_DEVICE_ID": "partner-pilot-device"
      }
    },
    "pilot-ios": {
      "developmentClient": false,
      "distribution": "store",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_NOVAID_TEST_MODE": "true",
        "EXPO_PUBLIC_NOVAID_APP_VERSION": "2026.1.0",
        "EXPO_PUBLIC_NOVAID_DEVICE_ID": "partner-pilot-ios-device"
      }
    },
    "test": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_NOVAID_TEST_MODE": "true",
        "EXPO_PUBLIC_NOVAID_APP_VERSION": "2026.1.0",
        "EXPO_PUBLIC_NOVAID_DEVICE_ID": "partner-test-device"
      }
    }
  }
}
