{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afritechnology.com/contracts/app-registry.schema.json",
  "title": "NovaCodePro Application Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "platform", "apps"],
  "properties": {
    "contractVersion": {
      "type": "integer",
      "minimum": 1
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "route", "icon", "requiredPermissions", "featureFlag", "status", "domain", "description"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "route": { "type": "string", "pattern": "^/novacodepro(/.*)?$" },
          "icon": { "type": "string", "minLength": 1 },
          "requiredPermissions": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "featureFlag": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["active", "preview", "disabled"]
          },
          "domain": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
