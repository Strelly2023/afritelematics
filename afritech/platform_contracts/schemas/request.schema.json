{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novatech.example/contracts/request/1.0.0",
  "type": "object",
  "required": ["request_id", "operation", "tenant_id", "actor_id", "idempotency_key", "contract_version", "schema_version", "payload"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "operation": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"},
    "tenant_id": {"type": "string", "minLength": 1},
    "actor_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 8, "maxLength": 255},
    "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "correlation_id": {"type": "string", "minLength": 1},
    "payload": {"type": "object"}
  },
  "additionalProperties": false
}
