{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novatech.example/contracts/response/1.0.0",
  "type": "object",
  "required": ["request_id", "operation_id", "status", "tenant_id", "trust_level", "version_vector", "data", "links"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["ACCEPTED", "COMPLETED", "DENIED", "FAILED"]},
    "tenant_id": {"type": "string", "minLength": 1},
    "trust_level": {"type": "integer", "minimum": 0, "maximum": 6},
    "version_vector": {
      "type": "object",
      "required": ["platform", "contract", "schema", "api", "replay", "evidence", "signature"],
      "additionalProperties": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
    },
    "data": {},
    "errors": {"type": "array", "items": {"type": "object", "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "detail": {}}, "additionalProperties": false}},
    "links": {"type": "object", "additionalProperties": {"type": "string"}}
  },
  "additionalProperties": false
}
