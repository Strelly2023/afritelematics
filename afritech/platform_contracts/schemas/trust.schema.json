{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novatech.example/contracts/trust/1.0.0",
  "type": "object",
  "required": ["trust_id", "tenant_id", "operation_id", "actor_id", "policy_decision_id", "input_hash", "result_hash", "trust_level", "evidence_version", "replay_id", "signature"],
  "properties": {
    "trust_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "actor_id": {"type": "string", "minLength": 1},
    "policy_decision_id": {"type": "string", "minLength": 1},
    "input_hash": {"type": "string", "minLength": 32},
    "result_hash": {"type": "string", "minLength": 32},
    "trust_level": {"type": "integer", "minimum": 3, "maximum": 6},
    "evidence_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "replay_id": {"type": "string", "minLength": 1},
    "supersedes": {"type": "string", "minLength": 1},
    "signature": {"type": "object"}
  },
  "additionalProperties": false
}
