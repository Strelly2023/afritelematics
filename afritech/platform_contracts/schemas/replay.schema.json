{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novatech.example/contracts/replay/1.0.0",
  "type": "object",
  "required": ["replay_id", "operation_id", "tenant_id", "replay_version", "input_hash", "expected_result_hash", "actual_result_hash", "status"],
  "properties": {
    "replay_id": {"type": "string", "minLength": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "replay_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "input_hash": {"type": "string", "minLength": 32},
    "expected_result_hash": {"type": "string", "minLength": 32},
    "actual_result_hash": {"type": "string", "minLength": 32},
    "status": {"enum": ["VERIFIED", "MISMATCH", "UNSUPPORTED_VERSION", "FAILED"]},
    "verified_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
