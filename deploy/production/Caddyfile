{
	auto_https off
}

http://afritechnology.com, http://app.afritechnology.com {
	encode gzip zstd

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	@public_verify path /public/*
	handle @public_verify {
		reverse_proxy afritech-api:8000
	}

	@api path /health /auth/* /v1/* /ws/* /rides/* /system/* /passenger/* /driver/* /ride/*
	handle @api {
		reverse_proxy afritech-api:8000
	}

	handle {
		reverse_proxy afritech-dashboard:4173
	}
}

http://api.afritechnology.com {
	encode gzip zstd
	reverse_proxy afritech-api:8000
}

http://novacodepro.afritechnology.com {
	encode gzip zstd
	reverse_proxy novacodepro-portal:4174
}

http://verify.afritechnology.com {
	encode gzip zstd
	reverse_proxy afritech-api:8000
}
