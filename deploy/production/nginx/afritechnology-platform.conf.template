server {
    listen 443 ssl;
    http2 on;
    server_name download.afritechnology.com;

    ssl_certificate /etc/letsencrypt/live/afritechnology.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/afritechnology.com/privkey.pem;

    root /var/www/afritechnology-downloads;

    types {
        application/vnd.android.package-archive apk;
        application/octet-stream ipa;
        text/plain sha256;
        application/json json;
        text/html html;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    location /novaride/releases/ {
        try_files $uri =404;
        add_header X-Content-Type-Options nosniff always;
        add_header Cache-Control "public, max-age=300";
    }

    location /novaride/ {
        try_files $uri =404;
        add_header X-Content-Type-Options nosniff always;
        add_header Cache-Control "public, max-age=300";
    }

    location /novapay/releases/ {
        try_files $uri =404;
        add_header X-Content-Type-Options nosniff always;
        add_header Cache-Control "public, max-age=300";
    }

    location /novapay/ {
        try_files $uri =404;
        add_header X-Content-Type-Options nosniff always;
        add_header Cache-Control "public, max-age=300";
    }

    location /novaid/releases/ {
        try_files $uri =404;
        add_header X-Content-Type-Options nosniff always;
        add_header Cache-Control "public, max-age=300";
    }

    location /novaid/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=300";
        add_header X-Content-Type-Options nosniff always;
    }

    location ~* \.(apk|ipa|sha256|json)$ {
        try_files $uri =404;
        add_header X-Content-Type-Options nosniff always;
        add_header Cache-Control "public, max-age=300";
    }

    location = /novaride/rider.apk {
        alias /var/www/afritech-apk/novaride-rider-public-pilot-release.apk;
        default_type application/vnd.android.package-archive;
        add_header Cache-Control "public, max-age=300";
        add_header Content-Disposition "attachment; filename=novaride-rider-public-pilot-release.apk";
        add_header X-Content-Type-Options nosniff always;
    }

    location = /novaride/driver.apk {
        alias /var/www/afritech-apk/novaride-driver-public-pilot-release.apk;
