server {
    listen 80;
    server_name afritechnology.com *.afritechnology.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name afritechnology.com www.afritechnology.com app.afritechnology.com;

    ssl_certificate /etc/letsencrypt/live/afritechnology.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/afritechnology.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

