server {
    listen 443 ssl http2;
    server_name download.afritechnology.com;

    ssl_certificate /etc/letsencrypt/live/afritechnology.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/afritechnology.com/privkey.pem;

    location /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 'ok';
    }

    location ~ ^/(novaride|novapay|novaid)/(?<apk_file>[A-Za-z0-9._-]+\.(apk|apk\.sha256))$ {
        alias /var/www/afritech-apk/$apk_file;
        types {
            application/vnd.android.package-archive apk;
            text/plain sha256;
        }
        default_type application/octet-stream;
        add_header Cache-Control "public, max-age=300";
        add_header Content-Disposition "attachment; filename=$apk_file";
        add_header X-Content-Type-Options nosniff always;
    }

    location = /novaride/rider.apk {
        alias /var/www/afritech-apk/novaride-rider-public-pilot-release.apk;
        default_type application/vnd.android.package-archive;
        add_header Cache-Control "public, max-age=300";
        add_header Content-Disposition "attachment; filename=novaride-rider-public-pilot-release.apk";
        add_header X-Content-Type-Options nosniff always;
