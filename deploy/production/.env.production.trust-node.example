AFRITECH_DOMAIN=trust.afritech.example
AFRITECH_TLS_EMAIL=ops@afritech.example

AFRITECH_JWT_SECRET=replace-with-production-jwt-secret
AFRITECH_EVENT_INGESTION_SECRET=replace-with-production-event-secret
AFRIRIDE_JWT_SECRET=replace-with-production-afriride-jwt-secret
AFRIRIDE_EVENT_INGESTION_SECRET=replace-with-production-afriride-event-secret
AFRIRIDE_DJANGO_SECRET_KEY=replace-with-production-django-secret
AFRIRIDE_AUDIT_API_KEY=replace-with-production-audit-api-key

AFRITECH_SIGNING_PRIVATE_KEY_PATH=/run/secrets/afritech_private_key.pem
AFRITECH_SIGNING_PUBLIC_KEY_PATH=/run/secrets/afritech_public_key.pem

VITE_AFRIRIDE_API_URL=https://trust.afritech.example
VITE_AFRIRIDE_APP_VERSION=trust-node-1

# Live public-ledger anchoring. Replace every placeholder before enabling.
AFRITECH_CHAIN_MODE=sepolia
AFRITECH_CHAIN_NETWORK=sepolia
AFRITECH_CHAIN_RPC_URL_SEPOLIA=https://sepolia.infura.io/v3/replace-with-provider-key
AFRITECH_CHAIN_WS_URL_SEPOLIA=wss://sepolia.infura.io/ws/v3/replace-with-provider-key
AFRITECH_CHAIN_RPC_URL_BASE_SEPOLIA=https://base-sepolia.infura.io/v3/replace-with-provider-key
AFRITECH_CHAIN_WS_URL_BASE_SEPOLIA=wss://base-sepolia.infura.io/ws/v3/replace-with-provider-key
AFRITECH_CHAIN_RPC_URL_MAINNET=https://mainnet.infura.io/v3/replace-with-provider-key
AFRITECH_CHAIN_WS_URL_MAINNET=wss://mainnet.infura.io/ws/v3/replace-with-provider-key
AFRITECH_CHAIN_PRIVATE_KEY_PATH=/run/secrets/eth_private_key
AFRITECH_CHAIN_ADDRESS_CHECKSUM=0xYOUR_FUNDED_PUBLIC_LEDGER_WALLET
AFRITECH_CHAIN_ID=11155111
AFRITECH_CHAIN_CONTRACT_ADDRESS=0xYOUR_DEPLOYED_ARCHITECTURE_ANCHOR
AFRITECH_CHAIN_ENABLE_PUBLISH=true
AFRITECH_CHAIN_AUTO_PUBLISH_ON_PROOF=false
AFRITECH_CHAIN_ETHERSCAN_VERIFIED=false
AFRITECH_CHAIN_INDEX_BACKEND=file
AFRITECH_CHAIN_INDEX_FILE=/var/lib/afritech/anchor-index.json
AFRITECH_ECOSYSTEM_LIVE_RECEIPT_FILE=/var/lib/afritech/ecosystem-live-anchor.json
AFRITECH_CHAIN_EVENT_SUBSCRIBER_ENABLED=true
AFRITECH_CHAIN_EVENT_SUBSCRIBER_TRANSPORT=websocket
AFRITECH_CHAIN_EVENT_BACKFILL_ENABLED=true
AFRITECH_CHAIN_EVENT_RECONNECT_DELAY_SECONDS=5
AFRITECH_CHAIN_CONTRACT_DEPLOYMENT_BLOCK=11064832
AFRITECH_CHAIN_TX_TIMEOUT=120
AFRITECH_CHAIN_GAS_PRICE_GWEI=2
