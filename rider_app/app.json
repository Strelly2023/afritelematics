{
  "expo": {
    "name": "NovaPay Consumer (Test)",
    "slug": "novapay-consumer-test",
    "version": "2026.1.0",
    "orientation": "portrait",
    "splash": {
      "backgroundColor": "#FFFFFF"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "android": {
      "package": "com.novatech.novapay.consumer",
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.novatech.novapay.consumer",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "NovaPay uses the camera for QR payment and receipt capture flows.",
        "NSUserNotificationUsageDescription": "NovaPay sends payment, security, and transfer notifications."
      }
    },
    "extra": {
      "test_mode": true,
      "api_url": "https://your-backend-url",
      "eas": {
        "projectId": "e36e1093-11c0-4606-b2fb-846e982c9b24"
      }
    },
    "owner": "ostrinov23",
    "plugins": [
      "expo-secure-store"
    ]
  }
}
