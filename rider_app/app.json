{
  "expo": {
    "name": "NovaRide Rider",
    "slug": "novaride-rider",
    "version": "2026.1.4",
    "icon": "./assets/novaride-brand.png",
    "orientation": "portrait",
    "splash": {
      "image": "./assets/novaride-brand.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "android": {
      "package": "com.novatech.novaride.rider",
      "permissions": [
        "ACCESS_NETWORK_STATE",
        "CAMERA",
        "POST_NOTIFICATIONS"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.novatech.novaride.rider",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSPinnedDomains": {
            "api.afritechnology.com": {
              "NSIncludesSubdomains": true,
              "NSPinnedCAIdentities": [
                {
                  "SPKI-SHA256-BASE64": "brzvtCELCIZUo4sD/qPX0ccRtPsd3DY6RfmxpOU9oB4="
                }
              ]
            }
          }
        },
        "NSCameraUsageDescription": "NovaRide uses the camera for QR payment and receipt capture flows.",
        "NSUserNotificationUsageDescription": "NovaRide sends payment, security, and transfer notifications."
      }
    },
    "extra": {
      "test_mode": true,
      "api_url": "https://api.afritechnology.com",
      "eas": {
        "projectId": "e36e1093-11c0-4606-b2fb-846e982c9b24"
      }
    },
    "owner": "ostrinov23",
    "plugins": [
      "expo-secure-store"
    ]
  }
}
