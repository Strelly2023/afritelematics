{
  "cli": {
    "appVersionSource": "remote",
    "version": ">= 10.0.0"
  },
  "build": {
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "ios": { "simulator": false },
      "env": {
        "EXPO_PUBLIC_AFRIRIDE_TEST_MODE": "false",
        "EXPO_PUBLIC_AFRIRIDE_USE_MOCKS": "false",
        "EXPO_PUBLIC_NOVARIDE_API_URL": "https://api.afritechnology.com"
      }
    },
    "pilot-apk": {
      "developmentClient": false,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_AFRIRIDE_TEST_MODE": "true",
        "EXPO_PUBLIC_AFRIRIDE_APP_VERSION": "2026.1.1",
        "EXPO_PUBLIC_NOVARIDE_API_URL": "https://api.afritechnology.com",
        "EXPO_PUBLIC_NOVARIDE_RELEASE_CHANNEL": "PUBLIC_PILOT",
        "EXPO_PUBLIC_NOVARIDE_ENVIRONMENT": "PUBLIC_PILOT",
        "EXPO_PUBLIC_AFRIRIDE_DEVICE_ID": "rider-pilot-device"
      }
    },
    "pilot-ios": {
      "developmentClient": false,
      "distribution": "store",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_AFRIRIDE_TEST_MODE": "true",
        "EXPO_PUBLIC_AFRIRIDE_APP_VERSION": "2026.1.1",
        "EXPO_PUBLIC_NOVARIDE_API_URL": "https://api.afritechnology.com",
        "EXPO_PUBLIC_NOVARIDE_RELEASE_CHANNEL": "PUBLIC_PILOT",
        "EXPO_PUBLIC_NOVARIDE_ENVIRONMENT": "PUBLIC_PILOT",
        "EXPO_PUBLIC_AFRIRIDE_DEVICE_ID": "rider-pilot-ios-device"
      }
    },
    "test": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_AFRIRIDE_TEST_MODE": "true",
        "EXPO_PUBLIC_AFRIRIDE_APP_VERSION": "2026.1.1",
        "EXPO_PUBLIC_NOVARIDE_API_URL": "https://api.afritechnology.com",
        "EXPO_PUBLIC_NOVARIDE_RELEASE_CHANNEL": "PUBLIC_PILOT",
        "EXPO_PUBLIC_NOVARIDE_ENVIRONMENT": "PUBLIC_PILOT",
        "EXPO_PUBLIC_AFRIRIDE_DEVICE_ID": "rider-test-device"
      }
    }
  }
}
